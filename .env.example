# Environment
NODE_ENV=development

# Server
SERVER_HOST=example.com
SERVER_PORT=3777

# Database
DATABASE_URL=./data/clawforge.db

# AI
AI_PROVIDER=ollama
AI_MODEL=llama3.2

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenAI-compatible
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Anthropic (optional)
ANTHROPIC_API_KEY=

# Google Gemini (optional)
GEMINI_API_KEY=

# Logging
LOG_LEVEL=info

# Authentication
SESSION_SECRET=change-me-in-production
ACCESS_TOKEN=

# Agent Limits
MAX_ITERATIONS=50
MAX_RUNTIME_MS=1800000
MAX_TOOL_CALLS=200
MAX_RETRIES=3

# Workspace
WORKSPACE_ROOT=./workspaces

# Security
ENABLE_CORS=true
CORS_ORIGIN=http://localhost:5173